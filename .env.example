# UNSAID Studio - environment configuration
# Copy to .env.local (git-ignored). Placeholders only; never commit real values.

# --- Local app --------------------------------------------------------------
# The app binds to 127.0.0.1 by default (see package.json scripts).
# Optional locally. REQUIRED before the app is reachable from any other machine:
# when set, every page and API route requires this token (entered once at /login).
STUDIO_ACCESS_TOKEN=

# Where the private database, uploaded research, brand assets and generated media live.
# This directory is git-ignored and must never be served as a public asset folder.
UNSAID_STORAGE_DIR=./storage
UNSAID_MAX_UPLOAD_MB=25

# --- Language model (implemented: Anthropic Claude via the official SDK) ------
ANTHROPIC_API_KEY=
# Model used for guest responses. Default is Claude Opus 5.5.
UNSAID_LLM_MODEL=claude-opus-5-5

# --- Speech (Milestone 2 - adapter interfaces exist, no provider wired yet) ---
# Reserved names. Setting them does nothing until the adapter ships.
ELEVENLABS_API_KEY=

# --- Avatar (Milestone 3 - adapter interfaces exist, no provider wired yet) ---
# Reserved names. Tavus or HeyGen will be evaluated against current docs.
TAVUS_API_KEY=
HEYGEN_API_KEY=
