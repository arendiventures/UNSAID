{
  "name": "unsaid-studio",
  "version": "0.1.0",
  "private": true,
  "description": "UNSAID Studio - private production workspace for a human-hosted podcast featuring labeled AI simulations of public figures.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "assets:import": "tsx scripts/import-assets.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@elevenlabs/elevenlabs-js": "2.71.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pdf-parse": "2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
